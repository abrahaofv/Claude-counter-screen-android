<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">

    <!-- Session row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">

        <TextView android:id="@+id/session_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Session" android:textSize="12sp" android:textColor="#FFFFFF" />

        <ProgressBar android:id="@+id/session_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="2.5" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/notif_progress_session" />

        <TextView android:id="@+id/session_pct" android:layout_width="40dp" android:layout_height="wrap_content" android:text="0%" android:textSize="11sp" android:textColor="#FFFFFF" android:gravity="end" />

        <TextView android:id="@+id/session_time" android:layout_width="60dp" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#AAAAAA" android:gravity="end" android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Weekly row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/weekly_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Weekly" android:textSize="12sp" android:textColor="#FFFFFF" />

        <ProgressBar android:id="@+id/weekly_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="2.5" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/notif_progress_weekly" />

        <TextView android:id="@+id/weekly_pct" android:layout_width="40dp" android:layout_height="wrap_content" android:text="0%" android:textSize="11sp" android:textColor="#FFFFFF" android:gravity="end" />

        <TextView android:id="@+id/weekly_time" android:layout_width="60dp" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#AAAAAA" android:gravity="end" android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
